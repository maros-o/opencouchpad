{
  "name": "OpenRemote",
  "short_name": "Remote",
  "description": "Touchpad and keyboard for your computer.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#1a1f26",
