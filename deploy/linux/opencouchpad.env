# /etc/default/opencouchpad — settings for the OpenCouchpad service.
# After editing: sudo systemctl restart opencouchpad

# Name shown in the remote UI and to other OpenCouchpad computers.
#OPENCOUCHPAD_NAME="Living room"

# mDNS name: phones open http://<host>.local
OPENCOUCHPAD_HOST=remote

# Require a PIN (recommended on shared or guest networks).
#OPENCOUCHPAD_PIN=1234

# HTTP port (80 lets you type just "remote.local").
#OPENCOUCHPAD_PORT=80

# Keyboard layout of this computer for typing (auto-detected if unset).
#OPENCOUCHPAD_LAYOUT=us
