# /etc/default/openremote — settings for the OpenRemote service.
# After editing: sudo systemctl restart openremote

# Name shown in the remote UI and to other OpenRemote computers.
#OPENREMOTE_NAME="Living room"

# mDNS name: phones open http://<host>.local
OPENREMOTE_HOST=remote

# Require a PIN (recommended on shared or guest networks).
#OPENREMOTE_PIN=1234

# HTTP port (80 lets you type just "remote.local").
#OPENREMOTE_PORT=80

# Keyboard layout of this computer for typing (auto-detected if unset).
#OPENREMOTE_LAYOUT=us
